@using Portfolio.Services
@using System.Globalization
@using System.Threading
@implements IDisposable
@inject State State
@inject NavigationManager NavigationManager

<p class="typewriter" style="@AnimationStyle" role="status">@Command</p>

@code {
    [Parameter, EditorRequired]
    public VimCommandLine CurrentCommand { get; set; } = new("", "");

    private readonly CancellationTokenSource _cancellation = new();
    private string Command => $":{CurrentCommand.Command} {CurrentCommand.Args}";
    private double Duration => Command.Length / 8.0;
    private string AnimationStyle => $"--command-width: calc({Command.Length}ch + {(Command.Length * 0.15).ToString(CultureInfo.InvariantCulture)}em); --typing-duration: {Duration.ToString(CultureInfo.InvariantCulture)}s; --typing-steps: {Command.Length}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var route = CurrentCommand.Args switch
        {
            NavItems.Home => "",
            NavItems.Contacts => "Contact",
            NavItems.Projects => "Projects",
            _ => throw new InvalidOperationException($"Unknown navigation target: {CurrentCommand.Args}")
        };

        try
        {
            await Task.Delay(TimeSpan.FromSeconds(Duration + 0.5), _cancellation.Token);
            NavigationManager.NavigateTo(route);
            State.Reducer(new StateAction { Type = ActionType.CLEAR_COMMAND });
        }
        catch (OperationCanceledException) when (_cancellation.IsCancellationRequested)
        {
            // A newer command or route change superseded this animation.
        }
    }

    public void Dispose()
    {
        _cancellation.Cancel();
        _cancellation.Dispose();
    }
}
