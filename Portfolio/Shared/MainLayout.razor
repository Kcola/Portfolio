@using Portfolio.Services
@inherits LayoutComponentBase
@inject State State
@inject UseJavascript JS
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@implements IAsyncDisposable

<main @onkeydown="HandleKeyDown">
    <div class="left-border" aria-hidden="true">
        <ul>
            @for (var i = 0; i < BorderLineCount; i++)
            {
                <li>~</li>
            }
        </ul>
    </div>
    <div id="navigation" class="@($"navigation {(State.NavOpen ? "is-active" : "")}")">
        <Navbar CurrentRoute="@CurrentRoute"/>
    </div>
    <div class="header-controls">
        <CultureSelector/>
        <button type="button" aria-label="@(State.NavOpen ? Localizer["CloseNavigation"] : Localizer["OpenNavigation"])"
                aria-expanded="@(State.NavOpen ? "true" : "false")" aria-controls="navigation"
                class="@($"hamburger hamburger--collapse {(State.NavOpen ? "is-active" : "")}")"
                @onclick="HandleClick">
            <span class="hamburger-box">
                <span class="hamburger-inner"></span>
            </span>
        </button>
    </div>
    <div class="content" tabindex="-1" inert="@(State.NavOpen ? "" : null)">
        @Body
    </div>
    <div class="footer">
        <div class="command-line">
            @if (State.CurrentCommand.Command.Length > 0)
            {
                <VimCommand @key="State.CurrentCommand" CurrentCommand="@State.CurrentCommand"/>
            }
        </div>
        <ul class="vim-text-info" aria-hidden="true">
            <li>2</li>
            <li>6,15</li>
            <li>All</li>
        </ul>
    </div>
</main>

@code {
    private BrowserDimension? _dimensions;
    private DotNetObjectReference<MainLayout>? _reference;
    private bool _disposed;
    private string CurrentRoute => "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0].Trim('/');
    private int BorderLineCount
    {
        get
        {
            if (_dimensions is null)
            {
                return 0;
            }

            var fontSize = _dimensions.Width <= 768 ? 1.2 : 1.5;
            return Math.Max(0, (int)(_dimensions.Height / (16 * fontSize * 1.29411764706)) - 5);
        }
    }

    protected override void OnInitialized()
    {
        State.OnChange += StateHasChanged;
        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _reference = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("portfolio.startResizeListener", _reference);
            await UseWindow();
        }
    }

    [JSInvokable]
    public async Task UseWindow()
    {
        if (!_disposed)
        {
            _dimensions = await JS.GetDimensions();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void HandleClick()
    {
        State.Reducer(new StateAction
        {
            Type = ActionType.TOGGLE_NAVBAR,
            Payload = new State { NavOpen = !State.NavOpen }
        });
    }

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape" && State.NavOpen)
        {
            HandleClick();
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        State.Reducer(new StateAction
        {
            Type = ActionType.ENTER_COMMAND,
            Payload = new State()
        });
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        State.OnChange -= StateHasChanged;
        NavigationManager.LocationChanged -= HandleLocationChanged;
        if (_reference is not null)
        {
            await JSRuntime.InvokeVoidAsync("portfolio.stopResizeListener");
            _reference.Dispose();
        }
    }
}
