@using Portfolio.Services
@inject State State

<nav aria-label="@Localizer["MainNavigation"]">
    <ul>
        <li><a href="" @onclick="() => OpenFile(NavItems.Home)" @onclick:preventDefault
               class="@(CurrentRoute == "/" ? "active" : null)"
               aria-current="@(CurrentRoute == "/" ? "page" : null)">@Localizer["Home"]</a></li>
        <li><a href="https://arxiv.org/abs/1904.13231" target="_blank" rel="noopener noreferrer">@Localizer["Publications"]</a></li>
        <li><a href="Contact" @onclick="() => OpenFile(NavItems.Contacts)" @onclick:preventDefault
               class="@(CurrentRoute.Equals("/Contact", StringComparison.OrdinalIgnoreCase) ? "active" : null)"
               aria-current="@(CurrentRoute.Equals("/Contact", StringComparison.OrdinalIgnoreCase) ? "page" : null)">@Localizer["Contact"]</a></li>
        <li><a href="https://github.com/kcola" target="_blank" rel="noopener noreferrer">Github</a></li>
    </ul>
</nav>

@code {
    [Parameter]
    public string CurrentRoute { get; set; } = "/";

    private void OpenFile(string navItem)
    {
        State.Reducer(new StateAction
        {
            Type = ActionType.ENTER_COMMAND,
            Payload = new State { CurrentCommand = new VimCommandLine(Commands.OpenFile, navItem) }
        });
    }
}
