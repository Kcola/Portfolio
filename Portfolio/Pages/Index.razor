@page "/"
@using Portfolio.Services
@implements IDisposable
@inject State State

<div class="about">
    <p style="font-weight: bold">@Localizer["Greeting"]</p>
    <p class="last-line">@Localizer["Occupation"]
        @if (!State.NavOpen)
        {
            <span class="cursor">|</span>
        }
    </p>
</div>

@code{
    protected override void OnInitialized()
    {
        State.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }

}
