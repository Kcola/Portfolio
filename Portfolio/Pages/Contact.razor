@page "/Contact"
@using Portfolio.Services
@inject State State
@implements IDisposable
<div class="container">
    <a href="mailto:kolawole.campbell@gmail.com">kolawole.campbell@gmail.com</a>
    @if (!State.NavOpen)
    {
        <div class="images">
            <a href="https://linkedin.com/in/kola-campbell-a7515179/" target="_blank" rel="noopener noreferrer"><img src="images/linkedin.png" alt="LinkedIn" width="72" height="72"/></a>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        State.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }
}
